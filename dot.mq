# Graphviz DOT language parser implemented in mq
# https://graphviz.org/doc/info/lang.html

# ─── internal ─────────────────────────────────────────────────────────────────

def _dot_trim_quotes(s):
  let t = trim(s)
  | if (starts_with(t, "\"") && ends_with(t, "\"")):
      slice(t, 1, len(t) - 1)
    else:
      t
end

def _dot_parse_attrs(s):
  let t = trim(s)
  | if (len(t) == 0):
      dict()
    else:
      do
        let pairs = regex_match(t, "[A-Za-z_][A-Za-z0-9_]*\\s*=\\s*(?:\"[^\"]*\"|[^,\\s\\]]+)")
        | fold(pairs, dict(), fn(acc, pair):
            let m = capture(trim(pair), "^(?P<k>[A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(?P<v>.*)")
            | if (is_none(m["k"])): acc
              else: set(acc, trim(m["k"]), _dot_trim_quotes(trim(m["v"])))
          ;)
      end
end

def _dot_parse_line(line, nd_list, eg_list, attrs):
  let l = trim(line)
  | if (len(l) == 0 || l == "{" || l == "}" || starts_with(l, "//")):
      [nd_list, eg_list, attrs]
    # graph-level attribute blocks: graph/node/edge [...]
    elif (is_regex_match(l, "^(graph|node|edge)\\s*\\[")):
      do
        let m     = capture(l, "^(?P<scope>graph|node|edge)\\s*\\[(?P<body>[^\\]]*)\\]")
        | let scope = m["scope"]
        | let kv    = _dot_parse_attrs(if (is_none(m["body"])): "" else: m["body"])
        | [nd_list, eg_list, set(attrs, scope, kv)]
      end
    # edge: A -> B or A -- B (chains like A -> B -> C supported)
    elif (is_regex_match(l, "->|--")):
      do
        let is_dir = is_regex_match(l, "->")
        | let sep   = if (is_dir): "\\s*->\\s*" else: "\\s*--\\s*"
        | let raw_parts = split(l, sep)
        | let np    = len(raw_parts)
        | let last  = trim(raw_parts[np - 1])
        | let ea    = if (is_regex_match(last, "\\[")):
              do
                let m = capture(last, "\\[(?P<body>[^\\]]*)\\]")
                | if (is_none(m["body"])): dict() else: _dot_parse_attrs(m["body"])
              end
            else: dict()
        | let chain = map(raw_parts, fn(p):
            let pt = trim(p)
            | _dot_trim_quotes(if (is_regex_match(pt, "\\[")): trim(first(split(pt, "\\["))) else: pt)
          ;)
        | var nd2 = nd_list
        | var eg2 = eg_list
        | var idx = 0
        | let cn  = len(chain)
        | let _   = while (idx < cn - 1):
            let from_ = chain[idx]
            | let to_  = chain[idx + 1]
            | let edge = {"from": from_, "to": to_, "attrs": if (idx == cn - 2): ea else: dict()}
            | nd2 = fold([from_, to_], nd2, fn(acc, id_):
                if (any(acc, fn(n): n["id"] == id_;)):
                  acc
                else:
                  acc + [{"id": id_, "attrs": dict()}]
              ;)
            | eg2 = eg2 + [edge]
            | idx += 1
            | nd2
          end
        | [nd2, eg2, attrs]
      end
    # node: A [attrs] or A;
    elif (is_regex_match(l, "^(\"[^\"]+\"|[A-Za-z0-9_]+)\\s*(\\[|;|$)")):
      do
        let m = capture(l, "^(?P<id>\"[^\"]+\"|[A-Za-z0-9_]+)(?:\\s*\\[(?P<body>[^\\]]*)\\])?")
        | if (is_none(m["id"])):
            [nd_list, eg_list, attrs]
          else:
            do
              let id_  = _dot_trim_quotes(m["id"])
              | let na = if (is_none(m["body"])): dict() else: _dot_parse_attrs(m["body"])
              | let new_nd = if (any(nd_list, fn(n): n["id"] == id_;)):
                    map(nd_list, fn(n): if (n["id"] == id_): set(n, "attrs", na) else: n;)
                  else:
                    nd_list + [{"id": id_, "attrs": na}]
              | [new_nd, eg_list, attrs]
            end
      end
    else:
      [nd_list, eg_list, attrs]
end

# ─── public API ───────────────────────────────────────────────────────────────

# Parses a Graphviz DOT string and returns structured data.
# Output: { type, name, strict, nodes, edges, attrs }
def dot_parse(input):
  let raw    = to_string(input)
  | let hm   = capture(raw, "(?i)^\\s*(?P<strict>strict\\s+)?(?P<type>digraph|graph)\\s*(?P<name>\"[^\"]+\"|[A-Za-z0-9_]*)\\s*\\{")
  | if (is_none(hm["type"])):
      error("dot: could not find graph/digraph header")
    else:
      do
        let type_   = downcase(hm["type"])
        | let name_ = _dot_trim_quotes(if (is_none(hm["name"])): "" else: hm["name"])
        | let strict = not(is_none(hm["strict"])) && len(trim(hm["strict"])) > 0
        | let normalized = replace(replace(raw, "{", "{\n"), "}", "\n}")
        | let lines  = map(split(normalized, "\n"), fn(l): trim(replace(l, ";", ""));)
        | var nd_list = []
        | var eg_list = []
        | var attrs   = dict()
        | var i = 0
        | let n = len(lines)
        | let _ = while (i < n):
            let r  = _dot_parse_line(lines[i], nd_list, eg_list, attrs)
            | nd_list = r[0]
            | eg_list = r[1]
            | attrs   = r[2]
            | i += 1
            | nd_list
          end
        | {"type": type_, "name": name_, "strict": strict, "nodes": nd_list, "edges": eg_list, "attrs": attrs}
      end
end

# Returns true if the graph is directed.
def dot_is_directed(input):
  dot_parse(input)["type"] == "digraph"
end

# Returns nodes that have no incoming edges (source nodes in a digraph).
def dot_sources(input):
  let g       = dot_parse(input)
  | let targets = map(g["edges"], fn(e): e["to"];)
  | filter(g["nodes"], fn(n): not(any(targets, fn(t): t == n["id"];));)
end

def _dot_needs_quote(s):
  is_regex_match(s, "\\s|\"")
end

def _dot_quote_id(s):
  if (_dot_needs_quote(s)): "\"" + s + "\"" else: s
end

def _dot_attrs_to_str(attrs):
  let ks = keys(attrs)
  | if (len(ks) == 0):
      ""
    else:
      do
        let parts = map(ks, fn(k):
            let v = attrs[k]
            | if (_dot_needs_quote(v)): k + "=\"" + v + "\"" else: k + "=" + v
          ;)
        | " [" + join(parts, " ") + "]"
      end
end

def _dot_scope_line(scope, attrs):
  let ks = keys(attrs)
  | if (len(ks) == 0):
      ""
    else:
      do
        let parts = map(ks, fn(k):
            let v = attrs[k]
            | if (_dot_needs_quote(v)): k + "=\"" + v + "\"" else: k + "=" + v
          ;)
        | "  " + scope + " [" + join(parts, " ") + "]"
      end
end

# Converts a parsed graph object back into a Graphviz DOT string.
# Input: { type, name, strict, nodes, edges, attrs }
def dot_stringify(g):
  let sep        = if (g["type"] == "digraph"): "->" else: "--"
  | let prefix   = if (g["strict"]): "strict " else: ""
  | let name_str = if (len(g["name"]) > 0): " " + _dot_quote_id(g["name"]) else: ""
  | let header   = prefix + g["type"] + name_str
  | let ga       = if (is_none(g["attrs"]["graph"])): dict() else: g["attrs"]["graph"]
  | let na       = if (is_none(g["attrs"]["node"])):  dict() else: g["attrs"]["node"]
  | let ea       = if (is_none(g["attrs"]["edge"])):  dict() else: g["attrs"]["edge"]
  | let scope_lines = filter([_dot_scope_line("graph", ga), _dot_scope_line("node", na), _dot_scope_line("edge", ea)], fn(s): len(s) > 0;)
  | let node_lines  = map(g["nodes"], fn(n): "  " + _dot_quote_id(n["id"]) + _dot_attrs_to_str(n["attrs"]);)
  | let edge_lines  = map(g["edges"], fn(e): "  " + _dot_quote_id(e["from"]) + " " + sep + " " + _dot_quote_id(e["to"]) + _dot_attrs_to_str(e["attrs"]);)
  | let body     = join(scope_lines + node_lines + edge_lines, "\n")
  | header + " {\n" + body + "\n}"
end
